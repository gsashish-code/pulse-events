{
  "name": "@gsashish/pulse-events",
  "version": "0.1.0",
  "description": "Production-grade typed EventEmitter with wildcards, async handlers, replay, AbortSignal support, and full TypeScript event map inference",
  "type": "module",
  "license": "MIT",
  "author": "G S Ashish",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsashish/pulse-events.git"
  },
  "keywords": [
    "eventemitter",
    "events",
    "typed",
    "typescript",
    "wildcard",
    "async",
    "abortcontroller",
    "replay",
    "browser",
    "universal"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
